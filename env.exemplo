# Copie este arquivo para ".env" (na pasta api) e preencha.
# O ".env" NÃO vai para o Git: ele guarda segredos (senha do banco, JWT).
# Este ".env.exemplo" vai, para quem clonar saber o que preencher.

PORTA=3000

DB_HOST=127.0.0.1
DB_PORTA=3306
DB_USUARIO=root
DB_SENHA=coloque-a-senha-do-seu-mysql
DB_NOME=taskflow

# Segredo que assina os tokens de login. Use um texto longo e aleatório.
JWT_SEGREDO=troque-por-um-texto-longo-e-aleatorio
